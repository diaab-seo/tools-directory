---
export interface Props {
  categories: { slug: string; name: string }[];
  activeCategory?: string;
  activePricing?: string;
}

const { categories, activeCategory, activePricing } = Astro.props;

// Build the base URLs dynamically
const isActiveCat = (slug: string) => activeCategory === slug;
const isActivePricing = (slug: string) => activePricing === slug;

// Pricing logic: if we are in a category, persist it. If not, go back to top-level pricing filter.
const getPricingUrl = (pricingSlug: string) => {
    if (activePricing === pricingSlug) {
        // Toggle off
        return activeCategory ? `/tools/${activeCategory}/` : `/tools/`;
    }
    return activeCategory ? `/tools/${activeCategory}/${pricingSlug}/` : `/tools/${pricingSlug}/`;
};
---

<div class="w-full flex flex-col md:flex-row gap-4 items-center justify-between mb-10 pb-6 border-b border-slate-200 dark:border-slate-800">
  
  {/* Category Pills (Horizontal Scroll on Mobile) */}
  <div class="flex-1 w-full overflow-x-auto pb-2 -mb-2 no-scrollbar">
    <div class="flex space-x-2 min-w-max">
      <a 
        href="/tools/"
        class={`px-4 py-2 rounded-full text-sm font-medium transition-all ${!activeCategory ? 'bg-indigo-600 text-white shadow-md shadow-indigo-200 dark:shadow-indigo-900/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'}`}
      >
        All Categories
      </a>
      {categories.slice(0, 10).map(cat => (
        <a 
          href={`/tools/${cat.slug}/`}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-all ${isActiveCat(cat.slug) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-200 dark:shadow-indigo-900/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'}`}
        >
          {cat.name}
        </a>
      ))}
      <a href="/categories/" class="px-4 py-2 rounded-full text-sm font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center space-x-1">
        <span>More</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </div>

  {/* Pricing Filters */}
  <div class="flex space-x-2 flex-shrink-0 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
    <a 
      href={getPricingUrl('free')}
      class={`px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${isActivePricing('free') ? 'bg-emerald-500 text-white shadow-sm' : 'text-slate-600 dark:text-slate-300 hover:text-emerald-500 hover:bg-emerald-50 dark:hover:bg-emerald-500/10'}`}
    >
      Free
    </a>
    <a 
      href={getPricingUrl('freemium')}
      class={`px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${isActivePricing('freemium') ? 'bg-amber-500 text-white shadow-sm' : 'text-slate-600 dark:text-slate-300 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10'}`}
    >
      Freemium
    </a>
    <a 
      href={getPricingUrl('paid')}
      class={`px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${isActivePricing('paid') ? 'bg-indigo-500 text-white shadow-sm' : 'text-slate-600 dark:text-slate-300 hover:text-indigo-500 hover:bg-indigo-50 dark:hover:bg-indigo-500/10'}`}
    >
      Paid
    </a>
  </div>
</div>

<style>
/* Hide scrollbar for Chrome, Safari and Opera */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hide scrollbar for IE, Edge and Firefox */
.no-scrollbar {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}
</style>
