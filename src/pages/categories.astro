---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';

export const prerender = false; // Need D1 to fetch dynamic list

// Fetch all categories and their tool counts
const { results } = await env.DB.prepare(`
  SELECT c.id, c.name, c.slug, c.ai_description, COUNT(tc.tool_id) as tool_count 
  FROM categories c 
  LEFT JOIN tool_categories tc ON c.id = tc.category_id 
  GROUP BY c.id 
  ORDER BY c.name ASC
`).all();

const categories = results || [];

const pageTitle = "All AI Tool Categories | AI Prompts Mall";
const pageDescription = "Browse the complete list of artificial intelligence categories. Find specialized AI tools for image generation, code assistants, text-to-speech, marketing, and more.";
---
<Base 
  title={pageTitle}
  description={pageDescription}
>
  <div class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 py-16">
    <div class="container mx-auto px-4 md:px-8 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white mb-4">All AI Categories</h1>
      <p class="text-xl text-slate-600 dark:text-slate-400">
        Browse our extensive directory of AI tools organized by use case.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 md:px-8 py-16 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat: any) => (
        <a href={`/tools/${cat.slug}/`} class="group relative bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 hover:shadow-xl hover:border-indigo-500 dark:hover:border-indigo-500 transition-all duration-300">
          <div class="flex items-start justify-between mb-4">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {cat.name}
            </h2>
            <span class="inline-flex items-center justify-center px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full text-xs font-semibold">
              {cat.tool_count} {cat.tool_count === 1 ? 'tool' : 'tools'}
            </span>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed line-clamp-3">
             {cat.ai_description || `Discover the best free and paid ${cat.name} AI tools and software.`}
          </p>
        </a>
      ))}
    </div>
  </div>
</Base>
