---
import Base from '../../layouts/Base.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getToolBySlug, getRelatedTools } from '../../lib/db';
import { formatToolTitle } from '../../lib/seo';

export const prerender = false;

const { slug } = Astro.params;
const env = Astro.locals.runtime.env;

if (!slug) return Astro.redirect('/404');

// Primary D1 Lookup
const tool = await getToolBySlug(env, slug);
if (!tool) return Astro.redirect('/404');

// Secondary lookup for related tools (based on embeddings pipeline)
const relatedTools = await getRelatedTools(env, tool.id);

// SEO formatting
const primaryCategory = tool.cat_names?.split(',')[0] || '';
const pageTitle = formatToolTitle(tool.name, primaryCategory, tool.ai_title);
const pageDescription = tool.ai_meta || tool.description;
const currentUrl = `https://aipromptsmall.shop/tools/${tool.slug}/`;

const schemaData = {
  name: tool.name,
  description: pageDescription,
  url: currentUrl,
  image: tool.image_url,
  price: tool.pricing_slug === 'free' ? '0' : '9.99', // generic fallback for schema
  rating: tool.rating,
  votes: tool.votes
};

// Pricing styles
const badgeColor = tool.pricing_slug === 'free' ? 'bg-emerald-100 text-emerald-800 border-emerald-200' 
                 : tool.pricing_slug === 'freemium' ? 'bg-amber-100 text-amber-800 border-amber-200'
                 : 'bg-indigo-100 text-indigo-800 border-indigo-200';
---

<Base 
  title={pageTitle} 
  description={pageDescription}
  image={tool.image_url}
  schemaType="SoftwareApplication"
  schemaData={schemaData}
>
  <div class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800" data-pagefind-body data-pagefind-meta={`title:${tool.name}, pricing:${tool.pricing_slug || 'free'}`} data-pagefind-filter={`category:${primaryCategory}`}>
    
    {/* Page Header / Hero */}
    <div class="container mx-auto px-4 md:px-8 py-10 lg:py-16 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      {/* Tool Screenshot */}
      <div class="lg:col-span-7 flex justify-center">
        <div class="relative w-full rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800/50 aspect-[16/9]">
          <img src={tool.image_url} alt={`${tool.name} interface screenshot`} class="absolute inset-0 w-full h-full object-cover">
        </div>
      </div>

      {/* Primary Details Panel */}
      <div class="lg:col-span-5 flex flex-col h-full space-y-6 lg:pl-4">
        
        {/* Breadcrumbs */}
        <nav class="flex text-sm text-slate-500 font-medium space-x-2">
          <a href="/tools/" class="hover:text-indigo-600 transition">Tools</a>
          {primaryCategory && (
            <>
              <span>›</span>
              <a href={`/tools/${tool.cat_slugs?.split(',')[0]}/`} class="hover:text-indigo-600 transition truncate max-w-[150px]">{primaryCategory}</a>
            </>
          )}
        </nav>

        <div>
          <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight" data-pagefind-meta="title">
            {tool.name}
          </h1>
          <p class="text-xl text-slate-600 dark:text-slate-400 font-medium leading-relaxed">
            {tool.ai_intro || tool.description}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 py-4 border-y border-slate-200 dark:border-slate-800">
          <span class={`px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-widest border ${badgeColor}`}>
            {tool.pricing || 'Free'}
          </span>
          <div class="flex items-center text-amber-500 bg-amber-50 dark:bg-amber-500/10 px-3 py-1.5 rounded-full font-bold">
            <svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <span>{tool.rating ? tool.rating.toFixed(1) : 'New'} <span class="text-sm font-medium text-amber-600/70 ml-1">({tool.votes || 0})</span></span>
          </div>
        </div>

        <div class="pt-2">
          <a href={tool.url} target="_blank" rel="noopener nofollow sponsored" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-4 rounded-xl shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50 transition-all hover:-translate-y-1">
            <span>Visit Website</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  {/* In Depth Overview */}
  <section class="py-16 bg-white dark:bg-slate-950">
    <div class="container mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8 space-y-10">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-6">Overview</h2>
          <div class="prose prose-slate dark:prose-invert max-w-none prose-p:leading-relaxed prose-p:text-slate-600 dark:prose-p:text-slate-400 prose-headings:text-slate-900 dark:prose-headings:text-white">
            <p>{tool.description}</p>
          </div>
        </div>

        {tool.ai_use_cases && tool.ai_use_cases !== '[]' && (
          <div>
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Top Use Cases</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {JSON.parse(tool.ai_use_cases).map((useCase: string) => (
                <div class="flex items-start bg-slate-50 dark:bg-slate-900 p-4 rounded-xl border border-slate-100 dark:border-slate-800">
                  <div class="text-emerald-500 mr-3 mt-0.5">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  </div>
                  <span class="font-medium text-slate-700 dark:text-slate-300">{useCase}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="lg:col-span-4">
        {/* Additional sidebar info could go here, like pricing tiers if we had them or ad placements */}
        <div class="bg-indigo-50 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900/50 p-6 rounded-2xl sticky top-24">
           <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Categories</h3>
           <div class="flex flex-wrap gap-2">
             {tool.cat_names?.split(',').map((cat, i) => {
               const cSlug = tool.cat_slugs?.split(',')[i];
               return (
                  <a href={`/tools/${cSlug}/`} class="inline-block px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-indigo-500 rounded-lg text-sm font-medium transition text-slate-700 dark:text-slate-300">
                    {cat}
                  </a>
               );
             })}
           </div>
        </div>
      </div>
    </div>
  </section>

  {/* Related Tools (Generated from Gemini Embeddings / Cosine Similarity from D1) */}
  {relatedTools && relatedTools.length > 0 && (
    <section class="py-16 md:py-24 bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800">
      <div class="container mx-auto px-4 md:px-8">
        <div class="mb-10 text-center md:text-left">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white capitalize">Alternatives & Related Tools</h2>
          <p class="text-slate-600 dark:text-slate-400 mt-2">Tools similar to {tool.name} discovered by AI.</p>
        </div>
        
        <ToolGrid className="!grid-cols-1 sm:!grid-cols-2 lg:!grid-cols-3">
          {relatedTools.map(rt => (
             <a href={`/tools/${rt.slug}/`} class="group bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden hover:shadow-xl transition-all flex flex-col items-start hover:-translate-y-1">
               <img src={rt.image_url} alt={rt.name} class="w-full aspect-[16/9] object-cover bg-slate-100" />
               <div class="p-5 flex-1 flex flex-col">
                  <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">{rt.name}</h3>
                  <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">{rt.ai_meta}</p>
                  <div class="mt-4 mt-auto pt-4 border-t border-slate-100 dark:border-slate-800 w-full">
                     <span class="text-xs uppercase tracking-wider font-bold text-slate-500">{rt.pricing_slug || 'free'}</span>
                  </div>
               </div>
             </a>
          ))}
        </ToolGrid>
      </div>
    </section>
  )}
</Base>
